{
  "name": "@dim-ark/connect",
  "version": "0.1.0",
  "author": "Maksimilian Vasilev <criticald@proton.me>",
  "description": "Connector for dim-ark DBMS. Solve dynamic programming problems easily",
  "main": "js/api.js",
  "types": "js/api.d.ts",
  "browser": "js/api.browser.js",
  "exports": {
    ".": {
      "types": "./js/api.d.ts",
      "browser": "./js/api.browser.js",
      "node": "./js/api.js",
      "default": "./js/api.js"
    },
    "./package.json": "./package.json"
  },
  "napi": {
    "binaryName": "dim-ark-connect",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "initialMemory": 4000,
      "maximumMemory": 65536,
      "browser": {
        "fs": false,
        "asyncInit": false,
        "buffer": false,
        "errorEvent": true
      }
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "js/api.js",
    "js/api.d.ts",
    "js/api.browser.js",
    "browser.js",
    "dim-ark-connect.win32-x64-msvc.node",
    "dim-ark-connect.wasi-browser.js",
    "dim-ark-connect.wasi.cjs",
    "dim-ark-connect.wasi.d.cts",
    "dim-ark-connect.wasm32-wasi.wasm",
    "wasi-worker.mjs",
    "wasi-worker-browser.mjs"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:wasm": "napi build --platform --release --target wasm32-wasip1-threads",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test \"__test__/**/*.test.js\""
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@napi-rs/wasm-runtime": "^1.1.6",
    "emnapi": "^1.11.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "optionalDependencies": {
    "@dim-ark/connect-linux-arm64-gnu": "0.1.0",
    "@dim-ark/connect-linux-x64-gnu": "0.1.0",
    "@dim-ark/connect-win32-x64-msvc": "0.1.0"
  }
}
